cat > .gitignore << 'EOF'
# ==============================
# Linux School .gitignore
# ==============================

# OS files
.DS_Store
Thumbs.db

# Editor folders
.vscode/
.idea/

# Temporary files
*.tmp
*.temp
*.swp
*.swo
*~

# Logs
*.log

# Environment files
.env
.env.*

# Python cache, in case we add Python later
__pycache__/
*.py[cod]
.venv/
venv/

# Node files, in case GitHub Pages/docs tooling is added later
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build output
dist/
build/
_site/

# Archives
*.zip
*.tar
*.tar.gz

# Local lab output files
labs/output/
practice-output/
EOF
